# 기본 게임 상태 HUD입니다. 현재 실행자는 플레이어입니다.
scoreboard players set @s td.hud_count 0
tag @s add td.hud.actor
execute as @e[tag=td.enemy] run scoreboard players add @a[tag=td.hud.actor,limit=1] td.hud_count 1
tag @s remove td.hud.actor

execute if score $wave_state td.wave_state matches -1 run title @s actionbar [{text:'Money ',color:'gold'},{score:{name:'@s',objective:'td.money'},color:'yellow'},{text:' | Wave ',color:'aqua'},{score:{name:'$wave',objective:'td.wave'},color:'yellow'},{text:'/',color:'gray'},{score:{name:'$last_wave',objective:'td.wave'},color:'yellow'},{text:' | Core ',color:'red'},{score:{name:'$base',objective:'td.hp'},color:'yellow'},{text:'/',color:'gray'},{score:{name:'$core_hp',objective:'td.hp'},color:'yellow'},{text:' | Enemies ',color:'gray'},{score:{name:'@s',objective:'td.hud_count'},color:'yellow'},{text:' | Defeat',color:'red'}]
execute if score $wave_state td.wave_state matches 0 run title @s actionbar [{text:'Money ',color:'gold'},{score:{name:'@s',objective:'td.money'},color:'yellow'},{text:' | Wave ',color:'aqua'},{score:{name:'$wave',objective:'td.wave'},color:'yellow'},{text:'/',color:'gray'},{score:{name:'$last_wave',objective:'td.wave'},color:'yellow'},{text:' | Core ',color:'red'},{score:{name:'$base',objective:'td.hp'},color:'yellow'},{text:'/',color:'gray'},{score:{name:'$core_hp',objective:'td.hp'},color:'yellow'},{text:' | Enemies ',color:'gray'},{score:{name:'@s',objective:'td.hud_count'},color:'yellow'},{text:' | Ready',color:'gray'}]
execute if score $wave_state td.wave_state matches 1 run title @s actionbar [{text:'Money ',color:'gold'},{score:{name:'@s',objective:'td.money'},color:'yellow'},{text:' | Wave ',color:'aqua'},{score:{name:'$wave',objective:'td.wave'},color:'yellow'},{text:'/',color:'gray'},{score:{name:'$last_wave',objective:'td.wave'},color:'yellow'},{text:' | Core ',color:'red'},{score:{name:'$base',objective:'td.hp'},color:'yellow'},{text:'/',color:'gray'},{score:{name:'$core_hp',objective:'td.hp'},color:'yellow'},{text:' | Enemies ',color:'gray'},{score:{name:'@s',objective:'td.hud_count'},color:'yellow'},{text:' | Fighting',color:'green'}]
execute if score $wave_state td.wave_state matches 2 run title @s actionbar [{text:'Money ',color:'gold'},{score:{name:'@s',objective:'td.money'},color:'yellow'},{text:' | Wave ',color:'aqua'},{score:{name:'$wave',objective:'td.wave'},color:'yellow'},{text:'/',color:'gray'},{score:{name:'$last_wave',objective:'td.wave'},color:'yellow'},{text:' | Core ',color:'red'},{score:{name:'$base',objective:'td.hp'},color:'yellow'},{text:'/',color:'gray'},{score:{name:'$core_hp',objective:'td.hp'},color:'yellow'},{text:' | Enemies ',color:'gray'},{score:{name:'@s',objective:'td.hud_count'},color:'yellow'},{text:' | Prep ',color:'aqua'},{score:{name:'$wave_prep',objective:'td.wave_prep'},color:'yellow'},{text:'t',color:'gray'}]
execute if score $wave_state td.wave_state matches 3 run title @s actionbar [{text:'Money ',color:'gold'},{score:{name:'@s',objective:'td.money'},color:'yellow'},{text:' | Wave ',color:'aqua'},{score:{name:'$wave',objective:'td.wave'},color:'yellow'},{text:'/',color:'gray'},{score:{name:'$last_wave',objective:'td.wave'},color:'yellow'},{text:' | Core ',color:'red'},{score:{name:'$base',objective:'td.hp'},color:'yellow'},{text:'/',color:'gray'},{score:{name:'$core_hp',objective:'td.hp'},color:'yellow'},{text:' | Enemies ',color:'gray'},{score:{name:'@s',objective:'td.hud_count'},color:'yellow'},{text:' | Victory',color:'green'}]
execute unless score $wave_state td.wave_state matches -1 unless score $wave_state td.wave_state matches 0..3 run title @s actionbar [{text:'Money ',color:'gold'},{score:{name:'@s',objective:'td.money'},color:'yellow'},{text:' | Wave ',color:'aqua'},{score:{name:'$wave',objective:'td.wave'},color:'yellow'},{text:'/',color:'gray'},{score:{name:'$last_wave',objective:'td.wave'},color:'yellow'},{text:' | Core ',color:'red'},{score:{name:'$base',objective:'td.hp'},color:'yellow'},{text:'/',color:'gray'},{score:{name:'$core_hp',objective:'td.hp'},color:'yellow'},{text:' | Enemies ',color:'gray'},{score:{name:'@s',objective:'td.hud_count'},color:'yellow'},{text:' | State ',color:'gray'},{score:{name:'$wave_state',objective:'td.wave_state'},color:'yellow'}]
